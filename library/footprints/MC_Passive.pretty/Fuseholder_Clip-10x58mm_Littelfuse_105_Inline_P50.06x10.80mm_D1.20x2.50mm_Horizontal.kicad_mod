(footprint "Fuseholder_Clip-10x58mm_Littelfuse_105_Inline_P50.06x10.80mm_D1.20x2.50mm_Horizontal" (version 20240108) (generator "pcbnew") (generator_version "8.0") (layer "F.Cu")
  (descr "Pair of Littelfuse 105 003 (01050003H) PCB clips, spring brass tin, 15 A, UL E14721, for 10.3x57.2 mm ferrule fuses (Littelfuse SPXC/SPXV 1500 VDC). Per clip 2 pins 0.70x2.00 mm at P10.80 mm, slot 1.20x2.50 mm (Littelfuse 105/106/125 datasheet, Recommended Mounting Dimensions). Clip spacing scaled from the datasheet 10x38 layout (41.76 mm outer pins = fuse length + 2x1.83 mm) to the 57.20 mm SPXC body: outer pins 60.86 mm. Clips have no voltage rating; insulation is set by the PCB.")
  (tags "fuse clip 10x58 10.3x57 Littelfuse 105 01050003H SPXC SPXV 1500VDC solar")
