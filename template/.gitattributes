# LF everywhere: Git for Windows would otherwise check files out with CRLF (KiCad files, scripts, test fixtures)
* text=auto eol=lf
*.kicad_pcb text eol=lf
*.kicad_sch text eol=lf
*.kicad_pro text eol=lf
*.sh text eol=lf
bin/* text eol=lf
*.png binary
*.pdf binary
*.sqlite binary
*.bundle binary
*.kicad_prl text eol=lf
*.kicad_dru text eol=lf
*.kicad_sym text eol=lf
*.kicad_mod text eol=lf
